# Plantilla de configuración — copiar a .env y rellenar con tus propias credenciales.
# NUNCA subas el archivo .env con claves reales al repositorio.

# Clave de la API de Mistral AI (https://console.mistral.ai/)
MISTRAL_API_KEY=tu_clave_de_mistral_aqui

# MySQL / MariaDB (XAMPP usa root sin contraseña por defecto)
DB_USER=root
DB_PASSWORD=
